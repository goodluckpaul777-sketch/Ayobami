rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // Products catalog
    match /products/{productId} {
      // Anyone can browse store products
      allow read: if true;
      // Writes allowed for catalog management
      allow write: if true;
    }

    // Customer orders and inquiries
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if true;
    }
  }
}
