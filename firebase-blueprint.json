{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A fabric, sewing machine, or accessory product sold in the store.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "categoryLabel": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "unit": { "type": "string" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "description": { "type": "string" },
        "features": { "type": "array" },
        "inStock": { "type": "boolean" },
        "stockCount": { "type": "number" },
        "images": { "type": "array" }
      },
      "required": ["id", "name", "category", "price", "unit"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order or inquiry submitted through the store.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "deliveryAddress": { "type": "string" },
        "stateOrCity": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "grandTotal": { "type": "number" }
      },
      "required": ["customerName", "phoneNumber", "paymentMethod", "grandTotal"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Merchandise products catalog."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders and inquiries."
    }
  }
}
