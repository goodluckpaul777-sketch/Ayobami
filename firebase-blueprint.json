{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Clothing, shoes, fabrics, and native wear inventory items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "mainSection": { "type": "string" },
        "category": { "type": "string" },
        "categorySlug": { "type": "string" },
        "description": { "type": "string" },
        "availableStock": { "type": "number" },
        "minimumOrder": { "type": "number" },
        "unitLabel": { "type": "string" },
        "image": { "type": "string" },
        "colors": { "type": "array" },
        "fabricType": { "type": "string" },
        "isNewArrival": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "inStock": { "type": "boolean" }
      },
      "required": ["id", "name", "mainSection"]
    },
    "Setting": {
      "title": "StoreSettings",
      "description": "Store contact and configuration",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "address": { "type": "string" }
      }
    },
    "Inquiry": {
      "title": "CustomerInquiry",
      "description": "Customer order inquiries and quotation requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "inquiryNumber": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public storefront products viewable by all and editable by store managers"
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "Store configuration and contact details"
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Orders and inquiries submitted by visitors"
    }
  }
}
